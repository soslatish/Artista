{
  "expo": {
    "name": "Artista",
    "slug": "artista",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artista",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.aleksandr.artista",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aleksandr.artista",
      "versionCode": 20,
      "adaptiveIcon": {
        "backgroundColor": "#622D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#622D32",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Artista использует фото, чтобы вы могли добавить снимки своих работ.",
          "cameraPermission": "Artista использует камеру, чтобы вы могли сфотографировать работу."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#622D32"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}