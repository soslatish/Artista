# Скопируйте в .env и заполните. Файл .env не коммитится.
APP_ENV=dev
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
# адрес, по которому приложение видит API (для ссылок на фото)
PUBLIC_BASE_URL=http://localhost:8080
# stub — тестовые платежи: любой покупатель может «оплатить» без денег.
# Только для стенда! В APP_ENV=prod сервер со stub не стартует.
PAYMENTS_PROVIDER=stub
ALLOW_STUB_PAYMENTS=true
CORS_ORIGINS=*
HTTP_PORT=8080

# --- Сайт и ссылки в приложение ---
# публичный адрес сайта (OG-превью, sitemap, QR сертификатов); пусто — берётся PUBLIC_BASE_URL
SITE_URL=
# SHA-256 отпечатки ключа подписи Android через запятую (Play Console → App signing) — для App Links
ANDROID_CERT_FINGERPRINTS=
# Team ID из Apple Developer — для Universal Links (apple-app-site-association)
APPLE_TEAM_ID=
# ссылки на магазины на лендинге; App Store появится, когда приложение опубликуют
STORE_GOOGLE_PLAY=https://play.google.com/store/apps/details?id=com.aleksandr.artista
STORE_RUSTORE=https://www.rustore.ru/catalog/app/com.aleksandr.artista
STORE_APP_STORE=
# адрес поддержки в подвале сайта и юридических документах; пусто — ссылка не показывается
SUPPORT_EMAIL=
