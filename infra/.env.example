# Скопируйте в .env и заполните. Файл .env не коммитится.
APP_ENV=dev
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
# адрес, по которому приложение видит API (для ссылок на фото)
PUBLIC_BASE_URL=https://api.proartista.ru
# stub — тестовые платежи; в APP_ENV=prod сервер откажется стартовать со stub
PAYMENTS_PROVIDER=stub
CORS_ORIGINS=*
HTTP_PORT=8080
