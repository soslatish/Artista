# Скопируйте в .env и заполните. Файл .env не коммитится.
APP_ENV=dev
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
# адрес, по которому приложение видит API (для ссылок на фото)
PUBLIC_BASE_URL=http://localhost:8080
# stub — тестовые платежи: любой покупатель может «оплатить» без денег.
# Только для стенда! В APP_ENV=prod сервер со stub не стартует.
PAYMENTS_PROVIDER=stub
ALLOW_STUB_PAYMENTS=true
CORS_ORIGINS=*
HTTP_PORT=8080
